# ================================================================
# Environment Variables — Backend Configuration
# ================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# ================================================================

# --- Environment ---
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:8080

# --- Omada Controller ---
# ⚠️ VERIFY: Check your controller's actual IP, port, and API endpoint paths.
OMADA_BASE_URL=https://192.168.1.252:8043
OMADA_API_TOKEN=your-controller-api-token-here
OMADA_SITE=Default
# Override paths only if your controller uses non-standard routes:
OMADA_AUTH_PATH=/extPortal/auth
OMADA_UNAUTH_PATH=/extPortal/unauth
OMADA_AUTH_TIMEOUT=10000
# Set to "false" only in development with self-signed certs on the controller:
OMADA_TLS_REJECT=true
# Set to "true" to bypass the controller entirely (mock mode for testing):
OMADA_MOCK=false

# --- Database ---
# SQLite (development):
DATABASE_URL=sqlite:./data/portal.db
# PostgreSQL (production):
# DATABASE_URL=postgresql://postgres:password@localhost:5432/portal

# --- Session Defaults ---
DEFAULT_SESSION_DURATION=60
SESSION_DURATION_OPTIONS=60,120,180,360,720,1440
PAUSE_ENABLED=true
# How often the expiration worker checks sessions (milliseconds):
SESSION_ENFORCE_INTERVAL=60000

# --- Redirect Allowlist ---
# Comma-separated list of domains allowed as redirect targets (after auth).
# Empty = allow any http/https URL.
ALLOWED_REDIRECT_DOMAINS=
DEFAULT_REDIRECT_URL=https://www.google.com

# --- Security ---
JWT_SECRET=change-this-to-a-random-secret-in-production
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=20
# Comma-separated allowed CORS origins:
CORS_ORIGINS=http://localhost:8080

# --- Logging ---
LOG_LEVEL=info
