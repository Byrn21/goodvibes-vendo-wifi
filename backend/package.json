{
  "name": "omada-captive-portal-backend",
  "version": "1.0.0",
  "description": "Backend server for Omada captive portal — supports voucher validation and Omada controller integration.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "lint": "eslint src/"
  },
  "dependencies": {
    "better-sqlite3": "^9.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "uuid": "^9.0.1",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "supertest": "^6.3.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/__tests__/**/*.js", "**/*.test.js"],
    "collectCoverageFrom": ["src/**/*.js", "!src/db/migrate.js", "!src/db/seed.js"],
    "coverageThreshold": {
      "global": { "branches": 50, "functions": 50, "lines": 50, "statements": 50 }
    }
  }
}
