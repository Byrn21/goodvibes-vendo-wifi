# ================================================================
# Environment Variables — GoodVibesVendoWifi Backend
# ================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# ================================================================

# --- Environment ---
NODE_ENV=production
PORT=8080
BASE_URL=https://goodvibesvendowifi-backend.fly.dev
FRONTEND_ORIGIN=https://goodvibesvendowifi.pages.dev

# --- Omada Controller ---
# ⚠️ VERIFY: Check your controller's actual IP, port, and API endpoint paths.
OMADA_BASE_URL=https://192.168.1.252:8043
OMADA_API_TOKEN=your-controller-api-token-here
OMADA_SITE=Default
# Override paths only if your controller uses non-standard routes:
OMADA_AUTH_PATH=/extPortal/auth
OMADA_UNAUTH_PATH=/extPortal/unauth
OMADA_AUTH_TIMEOUT=10000
# Set to "false" only in development with self-signed certs on the controller:
OMADA_TLS_REJECT=true
# Set to "true" to bypass the controller entirely (mock mode for testing):
OMADA_MOCK=false

# --- Database ---
# SQLite (production and development):
DATABASE_URL=sqlite:./data/portal.db

# --- Payment Provider ---
# Options: paymock | paymongo | xendit
PAYMENT_PROVIDER=xendit

# PayMongo (https://paymongo.com)
# PAYMONGO_SECRET_KEY=sk_test_your_paymongo_secret_key
# PAYMONGO_WEBHOOK_SECRET=whsec_your_paymongo_webhook_secret

# Xendit (https://xendit.co)
XENDIT_SECRET_KEY=your_xendit_secret_key_here
XENDIT_WEBHOOK_SECRET=your_xendit_webhook_secret_here
# Supported e-wallet channels: GCASH, PAYMAYA, SHOPEEPAY
XENDIT_EWALLET_CHANNELS=GCASH,PAYMAYA,SHOPEEPAY
# Enable QR Ph / QRIS (requires Xendit QR activation):
XENDIT_QRIS_ENABLED=true

# Payment base URLs (defaults work; override for sandbox/live)
PAYMENT_BASE_URL=https://api.xendit.co
PAYMENT_CHECKOUT_URL=https://checkout.xendit.co

# Price per hour in smallest currency unit (PHP centavos)
# 5000 = ₱50.00 per hour
PRICE_PER_HOUR=5000

# --- Session Defaults ---
DEFAULT_SESSION_DURATION=60
SESSION_DURATION_OPTIONS=60,120,180,360,720,1440
PAUSE_ENABLED=true
# How often the expiration worker checks sessions (milliseconds):
SESSION_ENFORCE_INTERVAL=60000

# --- Redirect Allowlist ---
# Comma-separated list of domains allowed as redirect targets (after auth).
# Empty = allow any http/https URL.
ALLOWED_REDIRECT_DOMAINS=
DEFAULT_REDIRECT_URL=https://www.google.com

# --- Security ---
JWT_SECRET=change-this-to-a-random-secret-in-production
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=20
# Comma-separated allowed CORS origins:
CORS_ORIGINS=http://localhost:8080

# --- Logging ---
LOG_LEVEL=info
